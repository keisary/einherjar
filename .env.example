# Variables d'environnement EINHERJAR — modele a copier en `.env` (jamais versionne).
#
#   cp .env.example .env
#
# L'environnement est PRIORITAIRE sur config/credentials.json : un hebergement n'a
# jamais besoin du fichier, et un fichier oublie ne peut pas ecraser la production.

# --- Identifiants cTrader (compte demo ou live) ------------------------------
EINHERJAR_ENVIRONMENT=demo
EINHERJAR_HOST=demo.ctraderapi.com
EINHERJAR_CLIENT_ID=
EINHERJAR_CLIENT_SECRET=
EINHERJAR_ACCESS_TOKEN=
EINHERJAR_ACCOUNT_ID=
EINHERJAR_BROKER_NAME=spotware

# --- Acces a l'interface (page de connexion) ---------------------------------
# Sans mot de passe, l'application en genere un et l'ecrit une fois dans les logs.
EINHERJAR_AUTH_USERNAME=jovanny
EINHERJAR_AUTH_PASSWORD=
EINHERJAR_AUTH_SECRET=

# --- Reglages d'exploitation --------------------------------------------------
# Port d'ecoute (l'hebergeur l'impose souvent, ex. Render).
PORT=8000
# Budget maximal de l'amorcage historique broker, en secondes.
EINHERJAR_BOOTSTRAP_BUDGET_S=240
