[Unit]
Description=EINHERJAR - systeme de trading algorithmique cTrader (API + boucle d'inference)
Documentation=https://github.com/keisary/einherjar
After=network-online.target
Wants=network-online.target
# Un redemarrage en boucle masquerait la cause reelle : on borne les tentatives.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=einherjar
Group=einherjar
WorkingDirectory=/opt/einherjar
# Chemin du fichier d'environnement (identifiants cTrader + page de connexion).
EnvironmentFile=/opt/einherjar/.env
ExecStart=/opt/einherjar/.venv/bin/python main.py
Restart=always
RestartSec=10
# Le cache de compilation Numba survit aux redemarrages : sans lui, chaque redemarrage
# recompile tout le pipeline (93 s sur un poste multicœur, 30-50 min sur 0,1 CPU).
Environment=NUMBA_CACHE_DIR=/opt/einherjar/data/numba_cache
# Cloisonnement minimal : l'application n'a besoin d'ecrire que dans son dossier.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/einherjar/data

[Install]
WantedBy=multi-user.target
